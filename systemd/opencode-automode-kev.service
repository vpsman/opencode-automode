# Kev decision model for opencode-automode, on llama.cpp's llama-server (localhost only).
# Install: run scripts/fetch.sh, cp this file to ~/.config/systemd/user/, then
#   systemctl --user daemon-reload && systemctl --user enable --now opencode-automode-kev
# The plugin asks (never allows) when this server is down, so a stopped service only costs prompts.
[Unit]
Description=Kev decision model for opencode-automode (llama-server)

[Service]
Environment=OPENCODE_AUTOMODE_HOME=%h/.local/share/opencode-automode
ExecStart=/bin/sh -c 'exec "$OPENCODE_AUTOMODE_HOME/llama/b12283/llama-b12283/llama-server" -m "$OPENCODE_AUTOMODE_HOME/models/Kev-0.8B-Q8_0.gguf" --host 127.0.0.1 --port 11438 --no-webui --parallel 1 --ctx-size 4096 --sleep-idle-seconds 300'
Restart=on-failure
RestartSec=5
Nice=5

[Install]
WantedBy=default.target
